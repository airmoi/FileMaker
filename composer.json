{
    "name": "airmoi/filemaker",
    "description": "Rewritten FileMaker PHP-API",
    "keywords": ["filemaker","PHP-API"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Romain Dunand",
            "email": "romain@1-more-thing.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "airmoi\\FileMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "airmoi\\FileMaker\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "psalm/phar": "^6.0"
    },
    "scripts": {
        "test": "phpunit --testsuite unit"
    }
}
