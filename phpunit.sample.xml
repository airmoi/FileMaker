<?xml version="1.0" encoding="UTF-8"?>
<!--
    Copy this file to phpunit.xml and adjust the connection settings to run the
    integration suite against a FileMaker Server hosting php-api-test.fmp12 (unzip tests/php-api-test.fmp12.zip):

        vendor/bin/phpunit (testsuite: integration)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <php>
        <var name="DB_HOST" value="localhost" />
        <var name="DB_USER" value="filemaker" />
        <var name="DB_PASSWD" value="filemaker" />
        <var name="DB_FILE" value="php-api-test" />
        <var name="OFFICIAL_API" value="0" />
        <var name="USE_DATA_API" value="false" />
    </php>
</phpunit>
